<Window x:Class="EasyVideoScreensaver.ChooseFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Choose media file" Height="200" Width="420" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Window.RenderTransform>
        <TranslateTransform x:Name="windowTranslateTransform" />
    </Window.RenderTransform>
    <Grid>
        <StackPanel Margin="10,10,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Label Content="URL" HorizontalAlignment="Left" Grid.Column="0" VerticalAlignment="Top"/>
                <TextBox HorizontalAlignment="Left" Name="URLFile" TextChanged="TextBox_TextChanged" TextWrapping="NoWrap" Grid.Column="1" Text="" VerticalAlignment="Center" Width="320" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="20"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Rectangle HorizontalAlignment="Left" Height="1" Grid.Column="0" Stroke="#FFB3B3B3" VerticalAlignment="Center" Width="160"/>
                <Label Content="Or" HorizontalAlignment="Center" Grid.Column="1" VerticalAlignment="Top" FontSize="8" />
                <Rectangle HorizontalAlignment="Left" Height="1" Grid.Column="2" Stroke="#FFB3B3B3" VerticalAlignment="Center" Width="160"/>
            </Grid>
            <StackPanel Orientation="Horizontal">
                <Button Content="Browse..." HorizontalAlignment="Left" VerticalAlignment="Top" Width="71" Click="Browse_Click"/>
                <Label Content="Local file" Name="LocalFile" HorizontalAlignment="Left" VerticalAlignment="Top" Width="268" FontSize="11"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Margin" Value="10,0,0,0"/>
                    </Style>
                </StackPanel.Resources>
                <Button Content="Done" HorizontalAlignment="Left" VerticalAlignment="Top" IsDefault="True" Width="71" Click="Done_Click"/>
                <Button Content="Cancel" HorizontalAlignment="Left" VerticalAlignment="Top" IsCancel="True" Width="71" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
