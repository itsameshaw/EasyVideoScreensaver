<Window x:Class="EasyVideoScreensaver.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyVideoScreensaver"
        mc:Ignorable="d"
        Title="Video Screensaver Settings" Height="420" Width="450" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:VideoUriRepresentation x:Key="fileRepresentation" />
    </Window.Resources>
    <Grid>
        <StackPanel Orientation="Vertical" Grid.ColumnSpan="3">
            <StackPanel.Resources>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Margin" Value="0,10,0,0"/>
                </Style>
            </StackPanel.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="120"></RowDefinition>
                    <RowDefinition Height="4"></RowDefinition>
                    <RowDefinition Height="23"></RowDefinition>
                </Grid.RowDefinitions>
                <Label Content="Video to Play:" HorizontalAlignment="Left" Grid.Column="1" Grid.Row="0" VerticalAlignment="Top" Padding="0" Height="23" VerticalContentAlignment="Center"/>
                <TextBox Name="VideoFilenameTextBox" Height="23" Grid.Column="2" Grid.Row="0" VerticalContentAlignment="Center" Visibility="Hidden" />
                <ListBox Grid.Column="2" Name="Videos">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource fileRepresentation}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Column="2" Grid.Row="2" Height="23" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="50"></ColumnDefinition>
                        <ColumnDefinition Width="50"></ColumnDefinition>
                        <ColumnDefinition Width="50"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Grid.Resources>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Margin" Value="4,0,0,0"/>
                        </Style>
                    </Grid.Resources>
                    
                    <Button Name="EditItem" Grid.Column="1" Content="Edit" Click="EditItem_Click" />
                    <Button Name="RemoveItem" Grid.Column="2" Content="-" Click="RemoveItem_Click" />
                    <Button Name="AddItem" Grid.Column="3" Content="+" Click="AddItem_Click" />
                </Grid>
                <Button Name="BrowseButton" Content="Browse..." Grid.Column="2" Grid.Row="2" VerticalAlignment="Top" Click="BrowseButton_Click" HorizontalAlignment="Left" Width="76" Visibility="Hidden" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Label Content="Play Mode:" HorizontalAlignment="Left" Grid.Column="1" VerticalAlignment="Top" Padding="0" Height="22" />
                <ComboBox Name="VideoPlayMode" VerticalAlignment="Top" Grid.Column="2" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Label Content="Video Size:" HorizontalAlignment="Left" Grid.Column="1" VerticalAlignment="Top" Padding="0" Height="22" />
                <ComboBox Name="StretchModeComboBox" VerticalAlignment="Top" Grid.Column="2" />
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Label Content="Volume:" HorizontalAlignment="Left" Grid.Column="1" VerticalAlignment="Top" Padding="0" Height="22" VerticalContentAlignment="Center"/>
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="35"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                    <Slider Name="VolumeSlider" HorizontalAlignment="Stretch" Grid.Column="0" VerticalAlignment="Center" Minimum="0" Maximum="1" TickFrequency="0.1" TickPlacement="BottomRight" SmallChange="0.01" ValueChanged="VolumeSlider_ValueChanged" LargeChange="0.1" Height="30" />
                    <Label Name="VolumeValueLabel" Content="0%" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Width="Auto" Padding="0" Height="22" />
                </Grid>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <CheckBox Name="MuteCheckBox" Content="Mute" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top" Checked="MuteCheckBox_Checked" Unchecked="MuteCheckBox_Unchecked"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="ResumeCheckBox" Grid.Column="2" Content="Resume from previous position" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </Grid>
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                    <ColumnDefinition Width="100"></ColumnDefinition>
                    <ColumnDefinition Width="120"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="85"></ColumnDefinition>
                    <ColumnDefinition Width="85"></ColumnDefinition>
                    <ColumnDefinition Width="8"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Button Name="Preview" Content="Preview" Grid.Column="1" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="90" Click="Preview_Click"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Name="VLC" Content="VLC Location" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="90" Click="VLC_Click" />
                    <Label Name="VLCValid" Foreground="DarkRed" Content="❌" Width="30" Height="20" FontSize="8" VerticalAlignment="Center" />
                </StackPanel>

                <Button Name="OKButton" Content="OK" Grid.Column="4" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="76" IsDefault="True" Click="OKButton_Click"/>
                <Button Name="CancelButton" Content="Cancel" Grid.Column="5" Height="20" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="76" IsCancel="True" Click="CancelButton_Click"/>
            </Grid>
        </StackPanel>

    </Grid>
</Window>
